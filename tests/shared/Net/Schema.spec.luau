--!strict
-- Validators reject wrong types, NaN/inf, out-of-range values and malformed tables without
-- throwing, and refuse to be declared without bounds. The bounds here are test values.

local T = require("../../TestKit")
local Schema = require("../../../src/shared/Net/Schema")
local Roblox = require("@lune/roblox")

local NAN = 0 / 0
local INF = math.huge

local function accepts(validator: Schema.Validator, value: any, label: string?)
	local ok, reason = validator.check(value)
	T.isTrue(ok, `{label or tostring(value)} should pass ({reason})`)
end

local function rejects(validator: Schema.Validator, value: any, label: string?)
	local ok = validator.check(value)
	T.equal(ok, false, `{label or tostring(value)} should be rejected`)
end

return T.suite("src/shared/Net/Schema", function(test)
	test("number checks type, range, integer and NaN/inf", function()
		local n = Schema.number({ min = 1, max = 10, integer = true })
		accepts(n, 1)
		accepts(n, 10)
		rejects(n, 0)
		rejects(n, 11)
		rejects(n, 2.5)
		rejects(n, NAN, "NaN")
		rejects(n, INF, "inf")
		rejects(n, -INF, "-inf")
		rejects(n, "5", "numeric string")
		rejects(n, true)
		rejects(n, {})
		local real = Schema.number({ min = -1, max = 1 })
		accepts(real, 0.5)
		rejects(real, NAN, "NaN on a non-integer number")
	end)

	test("number and other bounded types refuse missing or bad bounds", function()
		T.throws(function()
			Schema.number({ min = 1 } :: any)
		end, "max")
		T.throws(function()
			Schema.number({ min = NAN, max = 1 })
		end, "min")
		T.throws(function()
			Schema.number({ min = 5, max = 1 })
		end, "greater")
		T.throws(function()
			Schema.string({} :: any)
		end, "maxLength")
		T.throws(function()
			Schema.array(Schema.boolean(), {} :: any)
		end, "maxLength")
		T.throws(function()
			Schema.vector3({ maxMagnitude = INF })
		end, "maxMagnitude")
		T.throws(function()
			Schema.array({} :: any, { maxLength = 1 })
		end, "validator")
	end)

	test("string checks type, length and UTF-8", function()
		local s = Schema.string({ maxLength = 4, minLength = 1 })
		accepts(s, "abcd")
		accepts(s, "äöüß", "4 multi-byte characters")
		rejects(s, "")
		rejects(s, "abcde")
		rejects(s, "\255", "invalid UTF-8")
		rejects(s, string.rep("a", 10000), "huge string")
		rejects(s, 1)
	end)

	test("boolean and enum", function()
		accepts(Schema.boolean(), false)
		rejects(Schema.boolean(), 0)
		rejects(Schema.boolean(), nil, "nil")
		local tab = Schema.enum({ "Shop", "Pets" })
		accepts(tab, "Shop")
		rejects(tab, "shop")
		rejects(tab, 1)
	end)

	test("vector3 checks type, NaN components and magnitude", function()
		local v = Schema.vector3({ maxMagnitude = 2 })
		accepts(v, Roblox.Vector3.new(1, 0, 0))
		rejects(v, Roblox.Vector3.new(NAN, 0, 0), "NaN component")
		rejects(v, Roblox.Vector3.new(INF, 0, 0), "inf component")
		rejects(v, Roblox.Vector3.new(3, 0, 0), "too long")
		rejects(v, { X = 1, Y = 0, Z = 0 }, "table shaped like a vector")
	end)

	test("instance checks the class", function()
		local part = Schema.instance("BasePart")
		accepts(part, Roblox.Instance.new("Part"), "Part")
		rejects(part, Roblox.Instance.new("Folder"), "Folder")
		rejects(part, "Part")
	end)

	test("array rejects wrong-typed contents, holes, extra keys and overlong lists", function()
		local list = Schema.array(Schema.number({ min = 0, max = 5 }), { maxLength = 3 })
		accepts(list, {})
		accepts(list, { 1, 2, 3 })
		rejects(list, { 1, "2" }, "string element")
		rejects(list, { 1, NAN }, "NaN element")
		rejects(list, { 1, 9 }, "out-of-range element")
		rejects(list, { 1, 2, 3, 4 }, "too long")
		rejects(list, { [1] = 1, [3] = 3 }, "hole")
		-- selene: allow(mixed_table)
		rejects(list, { 1, x = 2 } :: any, "string key") -- mixed on purpose: a client can send one
		rejects(list, { [0.5] = 1 } :: any, "fractional key")
		rejects(list, 1, "not a table")
	end)

	test("struct requires its fields and refuses unknown keys", function()
		local s = Schema.struct({
			id = Schema.string({ maxLength = 8 }),
			count = Schema.optional(Schema.number({ min = 0, max = 3, integer = true })),
		})
		accepts(s, { id = "a" })
		accepts(s, { id = "a", count = 2 })
		rejects(s, { count = 2 }, "missing field")
		rejects(s, { id = "a", count = 9 }, "out-of-range field")
		rejects(s, { id = "a", extra = true }, "unknown key")
		rejects(s, { "a" }, "array instead of struct")
	end)

	test("optional accepts nil and checks anything else", function()
		local o = Schema.optional(Schema.boolean())
		T.isTrue(o.optional)
		accepts(o, nil, "nil")
		accepts(o, true)
		rejects(o, 1)
	end)
end)
